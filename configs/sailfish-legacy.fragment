# Experimental early Sailfish / systemd requirements, based on hybris-10.1.
# This is NOT a complete hardware adaptation and does not enable a modern SFOS.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_AUTOFS4_FS=y
CONFIG_UNIX=y
CONFIG_HOTPLUG=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSVIPC=y
CONFIG_NET=y
CONFIG_PROC_FS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECURITY_FILE_CAPABILITIES=y
CONFIG_VT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_SYSFS_DEPRECATED_V2 is not set
# CONFIG_DUMMY is not set
