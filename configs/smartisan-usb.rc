# User-requested always-on USB ADB, including before /system is mounted.
on init
    write /sys/class/usb_composite/usb_mass_storage/enable 0
    write /sys/class/usb_composite/rndis/enable 0
    write /sys/class/usb_composite/adb/enable 1
    start adbd

on boot
    setprop persist.service.adb.enable 1
    setprop persist.sys.root_access 3
    setprop persist.sys.usb.config adb
    setprop service.adb.root 1
    write /sys/class/usb_composite/usb_mass_storage/enable 0
    write /sys/class/usb_composite/adb/enable 1
    start adbd

on property:sys.usb.config=*
    write /sys/class/usb_composite/usb_mass_storage/enable 0
    write /sys/class/usb_composite/rndis/enable 0
    write /sys/class/usb_composite/adb/enable 1
    start adbd
    setprop sys.usb.state adb

on property:persist.sys.usb.config=*
    setprop sys.usb.config adb
