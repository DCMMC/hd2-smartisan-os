  "binary_patches": {
    "sailfish-adbd-patch.json": {
      "input_sha256": "223a28777cf36a4c0048b46542b9b47284774b2a72b99e8d3129584c41339c2d",
      "output_sha256": "48c8a410bec393c3a7bbd0c5b00f8b94ae7406c72d5b5efc5ecfcb5636675ba9",
      "property_trie_entry": "0x1ffb6",
      "guard_address": "0x2e5c0",
      "guard_bytes": 18,
      "reason": "Let the HD2 static adbd handle an absent early-boot Android property area.\n\nThe CM11 bionic property trie assumes /dev/__properties__ was initialized by\nAndroid init. Before that happens, its root pointer is NULL + 128. Treat that\ncase as an absent property, retaining the existing behavior for valid trees."
    },
    "sailfish-systemd-patch.json": {
      "input_sha256": "e9c8f917214024c92eb2295afdb0b500da6ba1eeab32fa14f382c4a877d5e920",
      "output_sha256": "cd8e12032f18c885d53739233fcbac0c831b40dad28f19ac7af1fa34aac5fafa",
      "literal_address": "0x52658",
      "reason": "Use the legacy kernel's writable tasks interface for systemd cg_attach.\n\nThis is a bring-up compatibility patch, not a kernel-wide cgroup.procs\nbackport. Service children are attached before exec and their later threads\ninherit that group. Moving an already multithreaded external process as a\nwhole remains unverified; this call moves the supplied task only.",
      "upstream_function": "https://github.com/systemd/systemd/blob/v208/src/shared/cgroup-util.c"
    },
    "sailfish-qpa-patch.json": {
      "input_sha256": "f60b6b6c6f410389906c2faaf777102b8d459de12dfd20b7187af966a503ef9a",
      "output_sha256": "07a4e88b960b10696050ad9ac63bfe59d96d39281ba6a4d28247ac5b229ff131",
      "file_offset": "0xecea",
      "old": "0821",
      "new": "0021",
      "change": "Qt HWC 32-bit framebuffer alpha size 8 -> 0 (RGBX)",
      "evidence": "logs/sailfish-first-boot/egl-configs.log",
      "runtime_verified": true,
      "runtime_evidence": "logs/sailfish-first-boot/sailfish-reboot-frame.png"
    },
